# Browser requests use /backend on the frontend's own origin.
# For shared data, set the SAME central API URL on every frontend clone.
API_PROXY_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional direct browser-to-API URL (normally leave unset):
# NEXT_PUBLIC_API_URL=https://api.your-project.example
# Offline ride simulation is opt-in; never silently create unsynced ride bookings.
NEXT_PUBLIC_ENABLE_DEMO_RIDES=false
# Optional OSRM-compatible routing server; defaults to the public OSRM demo.
# RIDE_ROUTER_URL=http://localhost:5001
