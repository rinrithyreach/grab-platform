# Copy to .env.local on every frontend clone, then set the same real API URL.
# A hosted project exposes its API at https://YOUR_SHARED_SITE/backend.
# Development mode also accepts http://MAIN_PC_IP:3000/backend on a trusted LAN.
API_PROXY_URL=https://YOUR_SHARED_SITE/backend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_RIDES=false
# Leave NEXT_PUBLIC_API_URL unset so browsers use the frontend's /backend proxy.
